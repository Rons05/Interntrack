<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Internship Tracker" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Internship Tracker">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap", "data-turbo-track": "reload" %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="sidebar">
    <body data-controller="sidebar">
    <% if current_user %>
      <%= render "shared/sidebar" %>
      <nav class="bg-[#1A1825] px-8 py-5 flex items-center gap-3 border-b border-white/5">
        <button data-action="click->sidebar#toggle" class="text-[#7C5CFC] text-2xl leading-none flex items-center">&#9776;</button>
        <h1 class="text-white text-xl leading-none flex items-center" style="font-family: 'Press Start 2P', monospace;">Intern<span class="text-[#7C5CFC]">Track</span></h1>
      </nav>
    <% end %>
    <%= yield %>
  </body>
</html>
