<div class="min-h-screen bg-[#0F0E17]">
  <div class="px-10 py-10 max-w-2xl mx-auto">
    <h2 class="text-3xl font-bold text-white mb-8">New Requirement</h2>

    <div class="bg-[#1A1825] rounded-xl p-8">
      <% if @requirement.errors.any? %>
        <div class="mb-4 bg-red-900/40 text-red-300 border border-red-500/30 p-3 rounded text-sm">
          <ul>
            <% @requirement.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @requirement, url: requirements_path, local: true do |f| %>
        <div class="mb-4">
          <%= f.label :name, "Requirement Name", class: "block text-[#9CA3AF] text-sm mb-1" %>
          <%= f.text_field :name, placeholder: "e.g. Resume, MOA, Weekly Report", class: "w-full p-2 bg-[#0F0E17] border border-white/10 text-white rounded" %>
        </div>

        <div class="mb-6">
          <%= f.label :status, "Status", class: "block text-[#9CA3AF] text-sm mb-1" %>
          <%= f.select :status, ["Pending", "Uploaded"], {}, class: "w-full p-2 bg-[#0F0E17] border border-white/10 text-white rounded" %>
        </div>

        <div class="flex gap-3">
          <%= f.submit "Save", class: "bg-[#7C5CFC] text-white px-6 py-2 rounded hover:opacity-90 cursor-pointer" %>
          <%= link_to "Cancel", requirements_path, class: "text-[#9CA3AF] hover:text-white px-6 py-2" %>
        </div>
      <% end %>
    </div>
  </div>
</div>