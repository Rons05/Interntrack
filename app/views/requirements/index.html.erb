<div class="min-h-screen bg-[#0F0E17]">
  <div class="px-10 py-10">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-3xl font-bold text-white">My Requirements</h2>
      <%= link_to "+ New Requirement", new_requirement_path, class: "bg-[#7C5CFC] text-white px-5 py-2 rounded-lg hover:opacity-90" %>
    </div>

    <% if @requirements.empty? %>
      <div class="bg-[#1A1825] rounded-xl p-10 text-center text-[#9CA3AF]">
        No requirements yet — click "New Requirement" to add one.
      </div>
    <% else %>
      <div class="grid gap-4">
        <% @requirements.each do |req| %>
          <div class="bg-[#1A1825] rounded-xl p-5 flex items-center justify-between border border-white/5">
            <div>
              <h3 class="text-white font-bold"><%= req.name %></h3>
              <p class="text-[#9CA3AF] text-xs mt-1">
                <% if req.status == "Uploaded" && req.uploaded_at %>
                  Uploaded on <%= req.uploaded_at.strftime("%b %d, %Y") %>
                <% else %>
                  Not uploaded yet
                <% end %>
              </p>
            </div>
            <div class="flex items-center gap-4">
              <span class="px-3 py-1 rounded-full text-xs font-semibold bg-white/10 text-white">
                <%= req.status %>
              </span>
              <% if req.status != "Uploaded" %>
                <%= button_to "Mark Uploaded", requirement_path(req), method: :patch, class: "text-[#7C5CFC] hover:underline text-sm bg-transparent" %>
              <% end %>
              <%= button_to "Delete", requirement_path(req), method: :delete, class: "text-red-400 hover:text-red-300 text-sm bg-transparent", form: { data: { turbo_confirm: "Delete this requirement?" } } %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>