<div class="min-h-screen bg-[#0F0E17]">
  <div class="px-10 py-10">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-3xl font-bold text-white">My Journal</h2>
      <%= link_to "+ New Entry", new_journal_path, class: "bg-[#7C5CFC] text-white px-5 py-2 rounded-lg hover:opacity-90" %>
    </div>

    <% if @journals.empty? %>
      <div class="bg-[#1A1825] rounded-xl p-10 text-center text-[#9CA3AF]">
        No entries yet — click "New Entry" to write your first one.
      </div>
    <% else %>
      <div class="grid gap-4">
        <% @journals.each do |entry| %>
          <div class="bg-[#1A1825] rounded-xl p-5 border border-white/5">
            <div class="flex items-center justify-between mb-2">
              <span class="text-[#9CA3AF] text-xs"><%= entry.created_at.strftime("%b %d, %Y") %></span>
              <%= button_to "Delete", journal_path(entry), method: :delete, class: "text-red-400 hover:text-red-300 text-xs bg-transparent", form: { data: { turbo_confirm: "Delete this entry?" } } %>
            </div>
            <p class="text-white text-sm"><%= entry.content %></p>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>