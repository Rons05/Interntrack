<div data-sidebar-target="panel" class="fixed top-0 left-0 h-full w-64 bg-[#1A1825] border-r border-white/5 -translate-x-full transition-transform duration-300 ease-in-out z-40">
  <div class="p-6">
    <div class="mb-10">
      <h1 class="text-white text-xl" style="font-family: 'Press Start 2P', monospace;">Intern<span class="text-[#7C5CFC]">Track</span></h1>
    </div>

    <nav class="flex flex-col gap-2">
      <%= link_to "Dashboard", root_path, class: "inline-flex items-center w-full text-[#9CA3AF] hover:text-white hover:bg-[#2A2740] px-4 py-2 rounded-lg" %>
      <%= link_to "Journal", journals_path, class: "inline-flex items-center w-full text-[#9CA3AF] hover:text-white hover:bg-[#2A2740] px-4 py-2 rounded-lg" %>
      <%= link_to "Logs", logs_path, class: "inline-flex items-center w-full text-[#9CA3AF] hover:text-white hover:bg-[#2A2740] px-4 py-2 rounded-lg" %>
      <%= link_to "Requirements", requirements_path, class: "inline-flex items-center w-full text-[#9CA3AF] hover:text-white hover:bg-[#2A2740] px-4 py-2 rounded-lg" %>
    </nav>
  </div>
  <div class="p-6">
    <%= button_to "Logout", logout_path, method: :delete, class: "w-full text-white bg-[#2A2740] px-4 py-2 rounded-lg hover:bg-[#3A3660]" %>
  </div>
</div>