<div class="min-h-screen bg-[#0F0E17]">
  <div class="px-10 py-10">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-3xl font-bold text-white">My Internship Applications</h2>
      <%= link_to "+ New Application", new_internship_path, class: "bg-[#7C5CFC] text-white px-5 py-2 rounded-lg hover:opacity-90" %>
    </div>

    <% if @internships.empty? %>
      <div class="bg-[#1A1825] rounded-xl p-10 text-center text-[#9CA3AF]">
        No applications yet — click "New Application" to add your first one.
      </div>
    <% else %>
      <div class="grid gap-4">
        <% @internships.each do |internship| %>
          <div class="bg-[#1A1825] rounded-xl p-5 flex items-center justify-between border border-white/5">
            <div>
              <h3 class="text-white font-bold text-lg"><%= internship.company_name %></h3>
              <p class="text-[#9CA3AF] text-sm"><%= internship.role %></p>
              <p class="text-[#9CA3AF] text-xs mt-1">Applied: <%= internship.date_applied&.strftime("%b %d, %Y") %></p>
            </div>
            <div class="flex items-center gap-4">
              <span class="px-3 py-1 rounded-full text-xs font-semibold
                <%= case internship.status
                    when "Applied" then "bg-blue-500/20 text-blue-300"
                    when "Interview" then "bg-yellow-500/20 text-yellow-300"
                    when "Offer" then "bg-green-500/20 text-green-300"
                    when "Rejected" then "bg-red-500/20 text-red-300"
                    else "bg-gray-500/20 text-gray-300"
                    end %>">
                <%= internship.status %>
              </span>
              <%= link_to "View", internship_path(internship), class: "text-[#7C5CFC] hover:underline text-sm" %>
              <%= link_to "Edit", edit_internship_path(internship), class: "text-[#9CA3AF] hover:text-white text-sm" %>
              <%= button_to "Delete", internship_path(internship), method: :delete, class: "text-red-400 hover:text-red-300 text-sm bg-transparent", form: { data: { turbo_confirm: "Are you sure?" } } %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>