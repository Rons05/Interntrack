<div class="min-h-screen bg-[#0F0E17]">
  <div class="px-10 py-10">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-3xl font-bold text-white">My Logs</h2>
      <%= link_to "+ New Log", new_log_path, class: "bg-[#7C5CFC] text-white px-5 py-2 rounded-lg hover:opacity-90" %>
    </div>

    <% if @logs.empty? %>
      <div class="bg-[#1A1825] rounded-xl p-10 text-center text-[#9CA3AF]">
        No logs yet — click "New Log" to add your first entry.
      </div>
    <% else %>
      <div class="bg-[#1A1825] rounded-xl overflow-hidden border border-white/5">
        <table class="w-full text-left">
          <thead>
            <tr class="border-b border-white/10 text-[#9CA3AF] text-sm">
              <th class="p-4">Date</th>
              <th class="p-4">Time In</th>
              <th class="p-4">Time Out</th>
              <th class="p-4">Total Hours</th>
              <th class="p-4"></th>
            </tr>
          </thead>
          <tbody>
            <% @logs.each do |log| %>
              <tr class="border-b border-white/5 text-white text-sm">
                <td class="p-4"><%= log.date_worked.strftime("%B %d, %Y") %></td>
                <td class="p-4"><%= log.time_in.strftime("%I:%M %p") %></td>
                <td class="p-4"><%= log.time_out.strftime("%I:%M %p") %></td>
                <td class="p-4 text-[#7C5CFC] font-bold"><%= log.hours %> hrs</td>
                <td class="p-4 text-right">
                  <%= button_to "Delete", log_path(log), method: :delete, class: "text-red-400 hover:text-red-300 text-xs bg-transparent", form: { data: { turbo_confirm: "Delete this log?" } } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>